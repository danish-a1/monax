{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monax",
  "version": "0.1.0",
  "identifier": "dev.monax.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monax",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../sidecars/qpdf": "sidecars/qpdf",
      "../sidecars/tesseract": "sidecars/tesseract",
      "../sidecars/wordcraft-cli": "sidecars/wordcraft-cli",
      "../sidecars/lib/": "sidecars/lib/",
      "../sidecars/tessdata/": "sidecars/tessdata/",
      "../sidecars/licenses/": "licenses/"
    },
    "macOS": {
      "frameworks": [
        "../vendor/pdfium/lib/libpdfium.dylib"
      ],
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
